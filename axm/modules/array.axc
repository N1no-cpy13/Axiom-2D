// array.axc - Array/List utilities module
// Usage: IMPORT "axm/modules/array.axc"

VAR __VERSION__ = "1.0"
VAR __AUTHOR__ = "AXIOM TEAM"

// Sum all elements in list
TASK Sum(lst)
  VAR total = 0
  FOR i IN LEN(lst)
    total = total + lst[i]
  RETURN total

// Average of list
TASK Average(lst)
  IF LEN(lst) == 0
    RETURN 0
  RETURN Sum(lst) / LEN(lst)

// Find max value
TASK Max(lst)
  IF LEN(lst) == 0
    RETURN 0
  VAR maxv = lst[0]
  FOR i IN LEN(lst)
    IF lst[i] > maxv
      maxv = lst[i]
  RETURN maxv

// Find min value
TASK Min(lst)
  IF LEN(lst) == 0
    RETURN 0
  VAR minv = lst[0]
  FOR i IN LEN(lst)
    IF lst[i] < minv
      minv = lst[i]
  RETURN minv

// Reverse list (returns new list)
TASK Reverse(lst)
  VAR result = []
  VAR i = LEN(lst) - 1
  WHILE i >= 0 DO
    APPEND(result, lst[i])
    i = i - 1
  RETURN result

// Check if list is empty
TASK IsEmpty(lst)
  RETURN LEN(lst) == 0

// Get first element
TASK First(lst)
  IF LEN(lst) == 0
    RETURN NULL
  RETURN lst[0]

// Get last element
TASK Last(lst)
  IF LEN(lst) == 0
    RETURN NULL
  RETURN lst[LEN(lst) - 1]

// Slice list (start, end) - end exclusive
TASK Slice(lst, start, end)
  VAR result = []
  VAR i = start
  WHILE i < end DO
    IF i >= 0 AND i < LEN(lst)
      APPEND(result, lst[i])
    i = i + 1
  RETURN result

// Filter list by predicate (returns list of values where predicate true)
// Note: AXM Don't have function pointer, so we use threshold here
TASK FilterGreater(lst, threshold)
  VAR result = []
  FOR i IN LEN(lst)
    IF lst[i] > threshold
      APPEND(result, lst[i])
  RETURN result

TASK FilterLess(lst, threshold)
  VAR result = []
  FOR i IN LEN(lst)
    IF lst[i] < threshold
      APPEND(result, lst[i])
  RETURN result

// Count occurrences of item
TASK Count(lst, item)
  VAR count = 0
  FOR i IN LEN(lst)
    IF lst[i] == item
      count = count + 1
  RETURN count