// validation.axc - Input validation module
// Usage: IMPORT "axm/modules/validation.axc"

VAR __VERSION__ = "1.0"
VAR __AUTHOR__ = "AXIOM TEAM"

// Check if string is empty
FUN IsEmpty(s)
  RETURN LEN(s) == 0

// Check if string is whitespace only
FUN IsWhitespace(s)
  IF LEN(s) == 0
    RETURN TRUE
  FOR i IN LEN(s)
    IF s[i] != " "
      RETURN FALSE
  RETURN TRUE

// Check if string is numeric (integer)
FUN IsNumeric(s)
  IF LEN(s) == 0
    RETURN FALSE
  VAR start = 0
  IF s[0] == "-"
    start = 1
  IF LEN(s) == start
    RETURN FALSE
  FOR i IN LEN(s) - start
    VAR c = s[start + i]
    IF c != "0" AND c != "1" AND c != "2" AND c != "3" AND c != "4" AND c != "5" AND c != "6" AND c != "7" AND c != "8" AND c != "9"
      RETURN FALSE
  RETURN TRUE

// Check if string is alphabetic (a-z, A-Z)
FUN IsAlpha(s)
  IF LEN(s) == 0
    RETURN FALSE
  FOR i IN LEN(s)
    VAR c = s[i]
    VAR is_lower = FALSE
    VAR is_upper = FALSE
    // Check lowercase
    IF c == "a" OR c == "b" OR c == "c" OR c == "d" OR c == "e"
      is_lower = TRUE
    IF c == "f" OR c == "g" OR c == "h" OR c == "i" OR c == "j"
      is_lower = TRUE
    IF c == "k" OR c == "l" OR c == "m" OR c == "n" OR c == "o"
      is_lower = TRUE
    IF c == "p" OR c == "q" OR c == "r" OR c == "s" OR c == "t"
      is_lower = TRUE
    IF c == "u" OR c == "v" OR c == "w" OR c == "x" OR c == "y" OR c == "z"
      is_lower = TRUE
    // Check uppercase
    IF c == "A" OR c == "B" OR c == "C" OR c == "D" OR c == "E"
      is_upper = TRUE
    IF c == "F" OR c == "G" OR c == "H" OR c == "I" OR c == "J"
      is_upper = TRUE
    IF c == "K" OR c == "L" OR c == "M" OR c == "N" OR c == "O"
      is_upper = TRUE
    IF c == "P" OR c == "Q" OR c == "R" OR c == "S" OR c == "T"
      is_upper = TRUE
    IF c == "U" OR c == "V" OR c == "W" OR c == "X" OR c == "Y" OR c == "Z"
      is_upper = TRUE
    IF NOT (is_lower OR is_upper)
      RETURN FALSE
  RETURN TRUE

// Validate range (inclusive)
FUN InRange(value, minv, maxv)
  RETURN value >= minv AND value <= maxv

// Validate positive number
FUN IsPositive(n)
  RETURN n > 0

// Validate negative number
FUN IsNegative(n)
  RETURN n < 0

// Validate email (simple check for "@" and ".")
FUN IsEmail(s)
  VAR has_at = FALSE
  VAR has_dot = FALSE
  FOR i IN LEN(s)
    VAR c = s[i]
    IF c == "@"
      has_at = TRUE
    IF c == "."
      has_dot = TRUE
  RETURN has_at AND has_dot