// vector.axc - Vector math module (2D/3D)
// Usage: IMPORT "axm/modules/vector.axc"
// Vectors are lists: [x, y] or [x, y, z]

VAR __VERSION__ = "1.1"
VAR __AUTHOR__ = "AXIOM TEAM"

// Add two vectors (same dimension)
FUN Add(a, b)
  VAR result = []
  FOR i IN LEN(a)
    APPEND(result, a[i] + b[i])
  RETURN result

// Subtract two vectors
FUN Sub(a, b)
  VAR result = []
  FOR i IN LEN(a)
    APPEND(result, a[i] - b[i])
  RETURN result

// Multiply vector by scalar
FUN Scale(v, s)
  VAR result = []
  FOR i IN LEN(v)
    APPEND(result, v[i] * s)
  RETURN result

// Dot product
FUN Dot(a, b)
  VAR total = 0
  FOR i IN LEN(a)
    total = total + a[i] * b[i]
  RETURN total

// Magnitude/length of vector
FUN Length(v)
  VAR total = 0
  FOR i IN LEN(v)
    total = total + v[i] * v[i]
  RETURN SQRT(total)

// Normalize vector (length = 1)
FUN Normalize(v)
  VAR len = Length(v)
  IF len == 0
    RETURN NULL
  RETURN Scale(v, 1 / len)

// Distance between two points
FUN Distance(a, b)
  RETURN Length(Sub(a, b))

// 2D distance (shortcut)
FUN Distance2D(x1, y1, x2, y2)
  VAR dx = x2 - x1
  VAR dy = y2 - y1
  RETURN SQRT(dx * dx + dy * dy)

// 3D distance (shortcut)
FUN Distance3D(x1, y1, z1, x2, y2, z2)
  VAR dx = x2 - x1
  VAR dy = y2 - y1
  VAR dz = z2 - z1
  RETURN SQRT(dx * dx + dy * dy + dz * dz)

// Linear interpolation between two vectors
FUN Lerp(a, b, t)
  VAR result = []
  FOR i IN LEN(a)
    APPEND(result, a[i] + (b[i] - a[i]) * t)
  RETURN result

// === GRAPHICS FUNCTIONS ===

// Rotate 2D vector around origin by angle (radians)
FUN Rotate2D(v, angle)
  VAR cos_a = COS(angle)
  VAR sin_a = SIN(angle)
  VAR x = v[0]
  VAR y = v[1]
  VAR new_x = x * cos_a - y * sin_a
  VAR new_y = x * sin_a + y * cos_a
  RETURN [new_x, new_y]

// Rotate 2D vector around pivot point
FUN RotateAround(v, pivot, angle)
  VAR dx = v[0] - pivot[0]
  VAR dy = v[1] - pivot[1]
  VAR cos_a = COS(angle)
  VAR sin_a = SIN(angle)
  VAR new_x = dx * cos_a - dy * sin_a + pivot[0]
  VAR new_y = dx * sin_a + dy * cos_a + pivot[1]
  RETURN [new_x, new_y]

// Reflect vector across X axis
FUN ReflectX(v)
  RETURN [v[0], -v[1]]

// Reflect vector across Y axis
FUN ReflectY(v)
  RETURN [-v[0], v[1]]

// Reflect vector across origin
FUN ReflectOrigin(v)
  RETURN [-v[0], -v[1]]

// Perpendicular vector (2D) — rotate 90 degrees
FUN Perpendicular(v)
  RETURN [-v[1], v[0]]

// Angle of 2D vector (radians)
FUN Angle(v)
  RETURN ATAN2(v[1], v[0])

// Angle between two 2D vectors (radians)
FUN AngleBetween(a, b)
  VAR dot = Dot(a, b)
  VAR len_a = Length(a)
  VAR len_b = Length(b)
  IF len_a == 0 OR len_b == 0
    RETURN 0
  VAR cos_angle = dot / (len_a * len_b)
  // Clamp to [-1, 1] to avoid domain error
  IF cos_angle < -1
    cos_angle = -1
  IF cos_angle > 1
    cos_angle = 1
  RETURN ACOS(cos_angle)

// Cross product (3D) — returns vector perpendicular to both
FUN Cross(a, b)
  VAR ax = a[0]
  VAR ay = a[1]
  VAR az = a[2]
  VAR bx = b[0]
  VAR by = b[1]
  VAR bz = b[2]
  VAR cx = ay * bz - az * by
  VAR cy = az * bx - ax * bz
  VAR cz = ax * by - ay * bx
  RETURN [cx, cy, cz]

// Project vector a onto vector b
FUN Project(a, b)
  VAR dot_ab = Dot(a, b)
  VAR dot_bb = Dot(b, b)
  IF dot_bb == 0
    RETURN NULL
  RETURN Scale(b, dot_ab / dot_bb)

// Clamp vector components between min and max
FUN ClampVec(v, minv, maxv)
  VAR result = []
  FOR i IN LEN(v)
    VAR val = v[i]
    IF val < minv
      val = minv
    IF val > maxv
      val = maxv
    APPEND(result, val)
  RETURN result

// Vector to string (debug)
FUN ToString(v)
  VAR result = "("
  FOR i IN LEN(v)
    IF i > 0
      result = result + ", "
    result = result + STR(v[i])
  RETURN result + ")"