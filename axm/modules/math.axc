// math.axc - Math utilities module
// Usage: IMPORT "axm/modules/math.axc"

VAR __VERSION__ = "1.0"
VAR __AUTHOR__ = "AXIOM TEAM"

// Constants
VAR PI = 3.14159
VAR E = 2.71828
VAR TAU = 6.28318

// Basic operations
TASK Square(x)
  RETURN x * x

TASK Cube(x)
  RETURN x * x * x

TASK Power(base, exp)
  RETURN base ** exp

TASK Sqrt(x)
  IF x < 0
    RETURN -1
  RETURN SQRT(x)

// Geometry
TASK CircleArea(r)
  RETURN PI * r * r

TASK CircleCircumference(r)
  RETURN TAU * r

TASK RectangleArea(w, h)
  RETURN w * h

TASK TriangleArea(base, height)
  RETURN (base * height) / 2

TASK SphereVolume(r)
  RETURN (4 / 3) * PI * r * r * r

TASK CylinderVolume(r, h)
  RETURN PI * r * r * h

// Distance
TASK Distance2D(x1, y1, x2, y2)
  VAR dx = x2 - x1
  VAR dy = y2 - y1
  RETURN SQRT(dx * dx + dy * dy)

TASK Distance3D(x1, y1, z1, x2, y2, z2)
  VAR dx = x2 - x1
  VAR dy = y2 - y1
  VAR dz = z2 - z1
  RETURN SQRT(dx * dx + dy * dy + dz * dz)

// Interpolation
TASK Lerp(a, b, t)
  RETURN a + (b - a) * t

TASK Clamp(value, minv, maxv)
  IF value < minv
    RETURN minv
  IF value > maxv
    RETURN maxv
  RETURN value

// Angle conversion
TASK DegToRad(deg)
  RETURN deg * PI / 180

TASK RadToDeg(rad)
  RETURN rad * 180 / PI

// Check number properties
TASK IsEven(n)
  RETURN MOD(n, 2) == 0

TASK IsOdd(n)
  RETURN MOD(n, 2) != 0

TASK IsPrime(n)
  IF n < 2
    RETURN FALSE
  VAR i = 2
  WHILE i * i <= n DO
    IF MOD(n, i) == 0
      RETURN FALSE
    i = i + 1
  RETURN TRUE

// Factorial
TASK Factorial(n)
  IF n < 0
    RETURN -1
  IF n == 0 OR n == 1
    RETURN 1
  VAR result = 1
  FOR i IN n
    result = result * (i + 1)
  RETURN result

// Fibonacci
TASK Fibonacci(n)
  IF n < 0
    RETURN -1
  IF n <= 1
    RETURN n
  VAR a = 0
  VAR b = 1
  FOR i IN n - 1
    VAR temp = a + b
    a = b
    b = temp
  RETURN b

// GCD (Greatest Common Divisor)
TASK GCD(a, b)
  WHILE b != 0 DO
    VAR temp = b
    b = MOD(a, b)
    a = temp
  RETURN a

// LCM (Least Common Multiple)
TASK LCM(a, b)
  RETURN (a * b) / GCD(a, b)