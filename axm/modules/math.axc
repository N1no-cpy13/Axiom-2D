// math.axc - Math utilities module
// Usage: IMPORT "axm/modules/math.axc"

VAR __VERSION__ = "1.0"
VAR __AUTHOR__ = "AXIOM TEAM"

// Constants
VAR PI = 3.14159
VAR E = 2.71828
VAR TAU = 6.28318

// Basic operations
FUN Square(x)
  RETURN x * x

FUN Cube(x)
  RETURN x * x * x

FUN Power(base, exp)
  RETURN base ** exp

FUN Sqrt(x)
  IF x < 0
    RETURN -1
  RETURN SQRT(x)

// Geometry
FUN CircleArea(r)
  RETURN PI * r * r

FUN CircleCircumference(r)
  RETURN TAU * r

FUN RectangleArea(w, h)
  RETURN w * h

FUN TriangleArea(base, height)
  RETURN (base * height) / 2

FUN SphereVolume(r)
  RETURN (4 / 3) * PI * r * r * r

FUN CylinderVolume(r, h)
  RETURN PI * r * r * h

// Distance
FUN Distance2D(x1, y1, x2, y2)
  VAR dx = x2 - x1
  VAR dy = y2 - y1
  RETURN SQRT(dx * dx + dy * dy)

FUN Distance3D(x1, y1, z1, x2, y2, z2)
  VAR dx = x2 - x1
  VAR dy = y2 - y1
  VAR dz = z2 - z1
  RETURN SQRT(dx * dx + dy * dy + dz * dz)

// Interpolation
FUN Lerp(a, b, t)
  RETURN a + (b - a) * t

FUN Clamp(value, minv, maxv)
  IF value < minv
    RETURN minv
  IF value > maxv
    RETURN maxv
  RETURN value

// Angle conversion
FUN DegToRad(deg)
  RETURN deg * PI / 180

FUN RadToDeg(rad)
  RETURN rad * 180 / PI

// Check number properties
FUN IsEven(n)
  RETURN MOD(n, 2) == 0

FUN IsOdd(n)
  RETURN MOD(n, 2) != 0

FUN IsPrime(n)
  IF n < 2
    RETURN FALSE
  VAR i = 2
  WHILE i * i <= n DO
    IF MOD(n, i) == 0
      RETURN FALSE
    i = i + 1
  RETURN TRUE

// Factorial
FUN Factorial(n)
  IF n < 0
    RETURN -1
  IF n == 0 OR n == 1
    RETURN 1
  VAR result = 1
  FOR i IN n
    result = result * (i + 1)
  RETURN result

// Fibonacci
FUN Fibonacci(n)
  IF n < 0
    RETURN -1
  IF n <= 1
    RETURN n
  VAR a = 0
  VAR b = 1
  FOR i IN n - 1
    VAR temp = a + b
    a = b
    b = temp
  RETURN b

// GCD (Greatest Common Divisor)
FUN GCD(a, b)
  WHILE b != 0 DO
    VAR temp = b
    b = MOD(a, b)
    a = temp
  RETURN a

// LCM (Least Common Multiple)
FUN LCM(a, b)
  RETURN (a * b) / GCD(a, b)