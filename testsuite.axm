IMPORT "axm/modules/vector.axc"

SAY "=== Test Vector Edge Cases ==="

// Normalize zero vector
VAR zero = [0, 0]
VAR norm_zero = vector.Normalize(zero)
SAYF "Normalize([0,0]): {norm_zero}"   // expected: [0, 0]

// Normalize normal vector
VAR v = [3, 4]
VAR norm = vector.Normalize(v)
SAYF "Normalize([3,4]): {norm}"        // expected: [0.6, 0.8]

// Project onto zero vector
VAR a = [1, 2]
VAR b = [0, 0]
VAR proj_zero = vector.Project(a, b)
SAYF "Project([1,2], [0,0]): {proj_zero}"  // expected: [0, 0]

// Project normal
VAR b2 = [1, 0]
VAR proj = vector.Project(a, b2)
SAYF "Project([1,2], [1,0]): {proj}"   // expected: [1, 0]

SAY "=== Done ==="